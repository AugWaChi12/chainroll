{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "storybook-static/**", "dist/**"]
    },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": {},
    "dev": { "cache": false, "persistent": true },
    "storybook": { "cache": false, "persistent": true }
  }
}
