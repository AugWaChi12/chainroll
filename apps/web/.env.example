# local | testnet | mainnet
NEXT_PUBLIC_CHAIN=local
# Override the ChainRoll address (default: packages/contracts deployments, or the anvil address for local)
NEXT_PUBLIC_CHAINROLL_ADDRESS=
# Bitkub NEXT SDK — from the KUB Developer Console / Playground (leave empty to hide the option)
NEXT_PUBLIC_BITKUB_CLIENT_ID=
NEXT_PUBLIC_BITKUB_SDK_ID=
