{
  "name": "@deekub/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/tokens/tokens.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006 --no-open",
    "build": "storybook build -o storybook-static --quiet"
  },
  "dependencies": {
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.77.0",
    "radix-ui": "1.8.1",
    "tailwind-merge": "3.7.1"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@deekub/config": "workspace:*",
    "@storybook/addon-a11y": "10.6.8",
    "@storybook/addon-docs": "10.6.8",
    "@storybook/addon-themes": "10.6.8",
    "@storybook/react-vite": "10.6.8",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
