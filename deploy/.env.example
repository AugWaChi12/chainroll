# Copy to /opt/chainroll/.env and set secrets via /opt/chainroll/deploy/set-key.sh <KEY>
DOMAIN=chainroll.art
NEXT_PUBLIC_CHAIN=testnet
POSTGRES_PASSWORD=change-me-with-set-key-sh
SESSION_SECRET=change-me-64-char-hex-secret
# Optional: Cloudflare R2 (Public CDN + Private 1/1 Master)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=chainroll-public
R2_PRIVATE_BUCKET=chainroll-private
R2_PUBLIC_BASE_URL=
# Optional: WalletConnect (Reown) & Bitkub NEXT
NEXT_PUBLIC_WC_PROJECT_ID=
NEXT_PUBLIC_BITKUB_CLIENT_ID=
NEXT_PUBLIC_BITKUB_SDK_ID=
